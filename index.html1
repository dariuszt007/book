<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>EPUB Reader</title>
  
    <!-- Link do ładnej ikonki na iPhone'a -->
     <link rel="apple-touch-icon" href="apple-touch-icon.png">

  <link rel="stylesheet" href="styles.css" />
  <script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/epubjs/dist/epub.min.js"></script>
</head>
<body>
  <header class="topbar" id="mainTopbar">
    <div>
      <h1>Biblioteka EPUB</h1>
      <p class="subtitle">Kliknij książkę, aby otworzyć czytnik</p>
    </div>
    <nav class="topbar-actions">
      <a class="btn secondary" href="admin.html">Panel administratora</a>
    </nav>
  </header>

  <main class="library-page" id="libraryPage">
    <aside class="reader-sidebar">
      <section class="panel">
        <div class="section-head">
          <h2>Biblioteka</h2>
          <button id="refreshLibraryBtn" class="btn">Odśwież</button>
        </div>

        <input id="searchBooksInput" type="text" placeholder="Szukaj książki..." />
        <div id="booksList" class="books-list"></div>
      </section>
    </aside>

    <section class="reader-main">
      <section class="panel">
        <div class="welcome-box">
          <h2>Wybierz książkę</h2>
          <p>Po kliknięciu książka otworzy się w pełnoekranowym czytniku EPUB.</p>
        </div>
      </section>
    </section>
  </main>

  <section class="reader-screen hidden" id="readerScreen">
    <div class="reader-overlay-top" id="readerTopBar">
      <button id="closeReaderBtn" class="icon-btn" aria-label="Zamknij">✕</button>

      <div class="reader-meta-compact">
        <div id="readerBookTitle" class="reader-title">Tytuł książki</div>
        <div id="readerBookAuthor" class="reader-author">Autor</div>
      </div>

      <button id="openMenuBtn" class="icon-btn" aria-label="Menu">☰</button>
    </div>

    <div class="reader-overlay-bottom" id="readerBottomBar">
      <div id="readingProgressText" class="progress-text">Postęp: 0%</div>
    </div>

    <div class="reader-center-tap-zone" id="toggleUiZone"></div>

    <div class="reader-content">
      <div class="reader-stage">
        <button id="prevPageBtn" class="tap-nav tap-nav-left" aria-label="Poprzednia strona"></button>
        <div id="viewer" class="viewer"></div>
        <button id="nextPageBtn" class="tap-nav tap-nav-right" aria-label="Następna strona"></button>
      </div>

      <aside id="menuDrawer" class="drawer hidden">
        <div class="drawer-inner">
          <div class="drawer-head">
            <h3>Menu czytnika</h3>
            <button id="closeMenuBtn" class="btn secondary">Zamknij</button>
          </div>

          <div class="drawer-actions">
            <button id="toggleLibraryBtn" class="btn secondary">Biblioteka</button>
            <button id="toggleTocBtn" class="btn secondary">Spis treści</button>
            <button id="toggleSettingsBtn" class="btn secondary">Motywy i ustawienia</button>
          </div>

          <div id="readerLibraryPanel" class="drawer-section hidden">
            <h4>Biblioteka</h4>
            <div id="readerBooksList" class="books-list compact-books"></div>
          </div>

          <div id="tocPanel" class="drawer-section hidden">
            <h4>Spis treści</h4>
            <div id="tocList" class="toc-list"></div>
          </div>

          <div id="readerSettingsPanel" class="drawer-section hidden">
            <h4>Motywy i ustawienia</h4>

            <div class="drawer-settings-controls">
              <div class="segmented-group">
                <button id="fontMinusBtn" class="seg-btn" aria-label="Zmniejsz czcionkę">A</button>
                <button id="fontPlusBtn" class="seg-btn seg-btn-large" aria-label="Zwiększ czcionkę">A</button>
              </div>

              <div class="segmented-group">
                <button id="spreadOneBtn" class="seg-btn" aria-label="Widok jednej strony">1 str.</button>
                <button id="spreadTwoBtn" class="seg-btn" aria-label="Widok dwóch stron">2 str.</button>
              </div>
            </div>

            <div class="drawer-theme-grid">
              <button class="theme-tile" data-theme="day">
                <span class="theme-aa">Aa</span>
                <span>Dzień</span>
              </button>

              <button class="theme-tile" data-theme="night">
                <span class="theme-aa">Aa</span>
                <span>Noc</span>
              </button>

              <button class="theme-tile active" data-theme="sepia">
                <span class="theme-aa">Aa</span>
                <span>Sepia</span>
              </button>

              <button class="theme-tile" data-theme="console">
                <span class="theme-aa">Aa</span>
                <span>Console</span>
              </button>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <script src="js/utils.js"></script>
  <script src="js/reader.js"></script>
</body>
</html>
