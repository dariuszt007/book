:root {
  --admin-bg: #0b1020;
  --admin-bg-soft: #11182b;
  --admin-panel: #131c31;
  --admin-panel-2: #0f1729;
  --admin-panel-3: #1a2540;
  --admin-line: rgba(148, 163, 184, 0.18);
  --admin-line-strong: rgba(148, 163, 184, 0.32);
  --admin-text: #ecf1ff;
  --admin-text-soft: #b6c2de;
  --admin-text-muted: #8d9bb8;
  --admin-primary: #4f46e5;
  --admin-primary-2: #4338ca;
  --admin-primary-soft: rgba(79, 70, 229, 0.18);
  --admin-accent: #60a5fa;
  --admin-success: #16a34a;
  --admin-danger: #dc2626;
  --admin-warning: #f59e0b;
  --admin-radius: 18px;
  --admin-radius-lg: 24px;
  --admin-shadow: 0 16px 40px rgba(0, 0, 0, 0.28);
  --admin-shadow-lg: 0 24px 60px rgba(0, 0, 0, 0.34);
  --admin-editor-bg: #ffffff;
  --admin-editor-text: #111827;
  --admin-toolbar-bg: #f3f4f6;
  --admin-toolbar-line: #d1d5db;
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
}

body.admin-body {
  min-height: 100vh;
  background:
    radial-gradient(circle at top left, rgba(79, 70, 229, 0.10), transparent 28%),
    radial-gradient(circle at top right, rgba(96, 165, 250, 0.08), transparent 24%),
    linear-gradient(180deg, #0b1020 0%, #0a0f1c 100%);
  color: var(--admin-text);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", Inter, Arial, sans-serif;
}

img {
  max-width: 100%;
  display: block;
}

button,
input,
textarea,
select {
  font: inherit;
}

a {
  color: inherit;
  text-decoration: none;
}

.admin-topbar {
  position: sticky;
  top: 0;
  z-index: 40;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20px;
  padding: 24px 28px;
  background: rgba(8, 13, 26, 0.82);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid var(--admin-line);
}

.admin-topbar__left {
  max-width: 900px;
}

.admin-topbar__right {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
}

.admin-eyebrow {
  margin: 0 0 8px 0;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #a5b4fc;
}

.admin-topbar h1 {
  margin: 0;
  font-size: 40px;
  line-height: 1.05;
  letter-spacing: -0.02em;
}

.admin-topbar__text {
  margin: 12px 0 0 0;
  max-width: 780px;
  color: var(--admin-text-soft);
  line-height: 1.6;
  font-size: 16px;
}

.admin-shell {
  padding: 24px;
  display: grid;
  gap: 22px;
}

.panel-box {
  background: linear-gradient(180deg, rgba(19, 28, 49, 0.96), rgba(13, 19, 34, 0.96));
  border: 1px solid var(--admin-line);
  border-radius: var(--admin-radius-lg);
  box-shadow: var(--admin-shadow);
  overflow: hidden;
}

.admin-start {
  padding: 26px;
}

.section-heading {
  margin-bottom: 22px;
}

.section-heading--split {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16px;
  flex-wrap: wrap;
}

.section-heading__actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.section-kicker {
  margin: 0 0 8px 0;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #93c5fd;
}

.section-heading h2 {
  margin: 0;
  font-size: 28px;
  line-height: 1.15;
  letter-spacing: -0.02em;
}

.section-text {
  margin: 12px 0 0 0;
  color: var(--admin-text-soft);
  line-height: 1.65;
  max-width: 900px;
}

.start-actions-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.start-card {
  appearance: none;
  -webkit-appearance: none;
  border: 1px solid var(--admin-line);
  background:
    linear-gradient(180deg, rgba(79, 70, 229, 0.08), rgba(255, 255, 255, 0.02)),
    var(--admin-panel-2);
  color: var(--admin-text);
  border-radius: 22px;
  min-height: 190px;
  padding: 22px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  text-align: left;
  cursor: pointer;
  transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  box-shadow: var(--admin-shadow);
}

.start-card:hover {
  transform: translateY(-2px);
  border-color: rgba(99, 102, 241, 0.55);
  box-shadow: var(--admin-shadow-lg);
}

.start-card--primary {
  background:
    linear-gradient(180deg, rgba(79, 70, 229, 0.22), rgba(79, 70, 229, 0.04)),
    var(--admin-panel-2);
  border-color: rgba(99, 102, 241, 0.32);
}

.start-card__icon {
  font-size: 30px;
  line-height: 1;
  color: #c7d2fe;
}

.start-card__title {
  font-size: 24px;
  font-weight: 800;
  line-height: 1.2;
}

.start-card__desc {
  color: var(--admin-text-soft);
  line-height: 1.55;
}

.workspace-grid {
  display: grid;
  grid-template-columns: 320px minmax(0, 1fr);
  gap: 22px;
  align-items: start;
}

.workspace-sidebar {
  padding: 22px;
  position: sticky;
  top: 112px;
}

.sidebar-header h2 {
  margin: 0;
  font-size: 24px;
  line-height: 1.2;
}

.sidebar-nav {
  margin-top: 20px;
  display: grid;
  gap: 10px;
}

.sidebar-nav__btn {
  appearance: none;
  -webkit-appearance: none;
  width: 100%;
  text-align: left;
  border: 1px solid var(--admin-line);
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.03);
  color: var(--admin-text);
  padding: 14px 16px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
}

.sidebar-nav__btn:hover {
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(148, 163, 184, 0.34);
}

.sidebar-nav__btn.active {
  background: linear-gradient(180deg, var(--admin-primary), var(--admin-primary-2));
  border-color: rgba(99, 102, 241, 0.72);
  color: #ffffff;
  box-shadow: 0 12px 24px rgba(79, 70, 229, 0.25);
}

.sidebar-sticky-actions {
  display: grid;
  gap: 10px;
  margin-top: 22px;
}

.workspace-main {
  min-width: 0;
  display: grid;
  gap: 22px;
}

.admin-section {
  display: none;
  padding: 24px;
}

.admin-section.active-section {
  display: block;
}

.admin-btn {
  appearance: none;
  -webkit-appearance: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  padding: 11px 16px;
  border-radius: 14px;
  border: 1px solid transparent;
  font-weight: 800;
  cursor: pointer;
  transition: transform 0.16s ease, filter 0.16s ease, background 0.16s ease, border-color 0.16s ease;
}

.admin-btn:hover {
  transform: translateY(-1px);
}

.admin-btn--primary {
  background: linear-gradient(180deg, var(--admin-primary), var(--admin-primary-2));
  color: #ffffff;
  border-color: rgba(99, 102, 241, 0.68);
}

.admin-btn--secondary {
  background: rgba(255, 255, 255, 0.04);
  color: var(--admin-text);
  border-color: var(--admin-line-strong);
}

.admin-btn--secondary:hover {
  background: rgba(255, 255, 255, 0.08);
}

.admin-btn--ghost {
  background: transparent;
  color: var(--admin-text);
  border-color: var(--admin-line-strong);
}

.admin-btn--ghost:hover {
  background: rgba(255, 255, 255, 0.06);
}

.admin-btn--danger {
  background: rgba(220, 38, 38, 0.14);
  color: #fecaca;
  border-color: rgba(220, 38, 38, 0.42);
}

.admin-btn--danger:hover {
  background: rgba(220, 38, 38, 0.24);
}

.info-cards-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin-bottom: 22px;
}

.info-card {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--admin-line);
  border-radius: 18px;
  padding: 18px;
}

.info-card h3 {
  margin: 0 0 10px 0;
  font-size: 20px;
  line-height: 1.25;
}

.info-card p {
  margin: 0;
  color: var(--admin-text-soft);
  line-height: 1.65;
}

.project-summary-box {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--admin-line);
  border-radius: 20px;
  padding: 18px;
}

.project-summary-box__header h3 {
  margin: 0;
  font-size: 20px;
}

.project-summary-box__header p {
  margin: 8px 0 0 0;
  color: var(--admin-text-soft);
}

.project-summary-grid {
  margin-top: 18px;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
}

.summary-item {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--admin-line);
  border-radius: 16px;
  padding: 14px;
}

.summary-item__label {
  display: block;
  margin-bottom: 8px;
  font-size: 12px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--admin-text-muted);
}

.repo-toolbar {
  margin-bottom: 18px;
}

.admin-input,
.admin-textarea {
  width: 100%;
  border: 1px solid var(--admin-line-strong);
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.04);
  color: var(--admin-text);
  padding: 13px 14px;
  outline: none;
  transition: border-color 0.16s ease, background 0.16s ease, box-shadow 0.16s ease;
}

.admin-input::placeholder,
.admin-textarea::placeholder {
  color: var(--admin-text-muted);
}

.admin-input:focus,
.admin-textarea:focus {
  border-color: rgba(96, 165, 250, 0.75);
  box-shadow: 0 0 0 4px rgba(96, 165, 250, 0.12);
  background: rgba(255, 255, 255, 0.06);
}

.admin-textarea {
  resize: vertical;
  min-height: 140px;
}

.admin-textarea--code {
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  white-space: pre-wrap;
  line-height: 1.55;
}

.form-grid {
  display: grid;
  gap: 16px;
  margin-bottom: 18px;
}

.form-grid--2 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.field {
  display: block;
}

.field span {
  display: inline-block;
  margin-bottom: 8px;
  font-weight: 700;
}

.repo-books-list {
  display: grid;
  gap: 16px;
}

.repo-book-card {
  display: grid;
  grid-template-columns: 88px minmax(0, 1fr) auto;
  gap: 16px;
  align-items: center;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--admin-line);
  border-radius: 18px;
  padding: 16px;
}

.repo-book-card__cover {
  width: 88px;
  height: 122px;
  border-radius: 14px;
  object-fit: cover;
  background: #ffffff;
  border: 1px solid rgba(148, 163, 184, 0.18);
}

.repo-book-card__meta h3 {
  margin: 0 0 8px 0;
  font-size: 19px;
  line-height: 1.25;
}

.repo-book-card__meta p {
  margin: 4px 0;
  color: var(--admin-text-soft);
}

.repo-book-card__actions {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.editor-layout {
  display: grid;
  grid-template-columns: 300px minmax(0, 1fr);
  gap: 20px;
  align-items: start;
}

.chapter-panel {
  border: 1px solid var(--admin-line);
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.03);
  padding: 16px;
}

.chapter-panel__head h3 {
  margin: 0;
  font-size: 20px;
}

.chapter-panel__head p {
  margin: 8px 0 0 0;
  color: var(--admin-text-soft);
}

.chapters-list {
  display: grid;
  gap: 10px;
  margin-top: 16px;
}

.chapter-item {
  appearance: none;
  -webkit-appearance: none;
  width: 100%;
  text-align: left;
  border: 1px solid var(--admin-line);
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.03);
  color: var(--admin-text);
  padding: 12px 14px;
  cursor: pointer;
  transition: border-color 0.16s ease, background 0.16s ease, transform 0.16s ease;
}

.chapter-item:hover {
  border-color: rgba(96, 165, 250, 0.48);
  background: rgba(255, 255, 255, 0.06);
}

.chapter-item.active {
  border-color: rgba(99, 102, 241, 0.72);
  background: rgba(79, 70, 229, 0.18);
}

.chapter-item strong {
  display: block;
  margin-bottom: 4px;
  font-size: 15px;
}

.chapter-item span {
  color: var(--admin-text-muted);
  font-size: 13px;
}

.editor-panel {
  min-width: 0;
  display: grid;
  gap: 14px;
}

.chapter-meta-row {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 12px;
}

.word-editor-box {
  border: 1px solid var(--admin-line);
  border-radius: 22px;
  overflow: hidden;
  background: var(--admin-editor-bg);
  box-shadow: var(--admin-shadow);
}

.word-editor-toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 14px;
  background: var(--admin-toolbar-bg);
  border-bottom: 1px solid var(--admin-toolbar-line);
}

.word-editor-toolbar button {
  appearance: none;
  -webkit-appearance: none;
  border: 1px solid var(--admin-toolbar-line);
  background: #ffffff;
  color: var(--admin-editor-text);
  min-height: 40px;
  padding: 8px 12px;
  border-radius: 10px;
  cursor: pointer;
  font-weight: 700;
  transition: background 0.16s ease, border-color 0.16s ease, transform 0.16s ease;
}

.word-editor-toolbar button:hover {
  background: #eef2ff;
  border-color: #a5b4fc;
}

.word-editor-surface {
  min-height: 520px;
  padding: 28px;
  background: var(--admin-editor-bg);
  color: var(--admin-editor-text);
  outline: none;
  font-size: 18px;
  line-height: 1.8;
  font-family: "Iowan Old Style", "Palatino Linotype", Georgia, serif;
}

.word-editor-surface h1,
.word-editor-surface h2,
.word-editor-surface h3 {
  color: var(--admin-editor-text);
}

.word-editor-surface p {
  margin: 0 0 1em 0;
}

.code-panel {
  display: grid;
}

.media-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
}

.media-card {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--admin-line);
  border-radius: 20px;
  padding: 18px;
}

.media-card h3 {
  margin: 0 0 14px 0;
  font-size: 20px;
}

.cover-preview-wrap {
  margin-top: 18px;
  min-height: 240px;
  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
}

.cover-preview {
  width: min(100%, 240px);
  aspect-ratio: 3 / 4;
  object-fit: cover;
  border-radius: 16px;
  border: 1px solid var(--admin-line);
  background: rgba(255, 255, 255, 0.04);
  display: none;
}

.images-list {
  margin-top: 16px;
  display: grid;
  gap: 12px;
}

.image-mini-card {
  display: grid;
  grid-template-columns: 72px 1fr;
  gap: 12px;
  align-items: center;
  padding: 12px;
  border-radius: 16px;
  border: 1px solid var(--admin-line);
  background: rgba(255, 255, 255, 0.03);
}

.image-mini-card img {
  width: 72px;
  height: 96px;
  object-fit: cover;
  border-radius: 12px;
  background: #ffffff;
}

.image-mini-card h4 {
  margin: 0 0 6px 0;
  font-size: 15px;
}

.image-mini-card p {
  margin: 0;
  color: var(--admin-text-soft);
  font-size: 13px;
}

.export-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin-bottom: 20px;
}

.export-card {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--admin-line);
  border-radius: 20px;
  padding: 18px;
}

.export-card h3 {
  margin: 0 0 10px 0;
  font-size: 20px;
}

.export-card p {
  margin: 0;
  color: var(--admin-text-soft);
  line-height: 1.6;
}

.export-card .admin-btn {
  margin-top: 14px;
  width: 100%;
}

.empty-state {
  border: 1px dashed var(--admin-line-strong);
  border-radius: 18px;
  padding: 18px;
  color: var(--admin-text-muted);
  background: rgba(255, 255, 255, 0.02);
}

/* RESPONSIVE */

@media (max-width: 1320px) {
  .start-actions-grid,
  .info-cards-grid,
  .export-grid {
    grid-template-columns: 1fr 1fr;
  }

  .project-summary-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 1100px) {
  .workspace-grid {
    grid-template-columns: 1fr;
  }

  .workspace-sidebar {
    position: static;
  }

  .editor-layout {
    grid-template-columns: 1fr;
  }

  .media-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 820px) {
  .admin-topbar {
    padding: 18px 16px;
    flex-direction: column;
    align-items: stretch;
  }

  .admin-topbar h1 {
    font-size: 32px;
  }

  .admin-shell {
    padding: 16px;
  }

  .admin-start,
  .admin-section,
  .workspace-sidebar {
    padding: 18px;
  }

  .start-actions-grid,
  .info-cards-grid,
  .export-grid,
  .form-grid--2 {
    grid-template-columns: 1fr;
  }

  .repo-book-card {
    grid-template-columns: 72px minmax(0, 1fr);
  }

  .repo-book-card__actions {
    grid-column: 1 / -1;
    flex-direction: row;
    flex-wrap: wrap;
  }

  .chapter-meta-row {
    grid-template-columns: 1fr;
  }

  .word-editor-surface {
    min-height: 420px;
    padding: 20px;
    font-size: 17px;
  }

  .project-summary-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 560px) {
  .admin-topbar h1 {
    font-size: 28px;
  }

  .section-heading h2 {
    font-size: 24px;
  }

  .start-card {
    min-height: 160px;
    padding: 18px;
  }

  .start-card__title {
    font-size: 21px;
  }

  .sidebar-nav__btn,
  .admin-btn {
    min-height: 48px;
  }

  .word-editor-toolbar {
    gap: 6px;
    padding: 12px;
  }

  .word-editor-toolbar button {
    min-height: 38px;
    padding: 8px 10px;
    font-size: 14px;
  }

  .word-editor-surface {
    min-height: 340px;
    padding: 16px;
    font-size: 16px;
    line-height: 1.7;
  }

  .repo-book-card {
    grid-template-columns: 1fr;
  }

  .repo-book-card__cover {
    width: 82px;
    height: 114px;
  }
}
